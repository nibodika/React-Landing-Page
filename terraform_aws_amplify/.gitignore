# Local .terraform directories
**/.terraform/*

# Terraform state files
*.tfstate
*.tfstate.*

# Crash logs
crash.log
crash.*.log

# Terraform variable files (may contain secrets)
terraform.tfvars
terraform.tfvars.json
*.auto.tfvars
*.auto.tfvars.json

# Terraform plan files
*.tfplan
plan.out

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terraform dependency lock file (optional)
# Uncomment the next line if you do NOT want to commit it.
.terraform.lock.hcl

# CLI configuration files
.terraformrc
terraform.rc

# Sensitive files
*.pem
*.key